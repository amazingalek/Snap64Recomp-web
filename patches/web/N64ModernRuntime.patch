+extern "C" int recomp_redirect(uint8_t* rdram, recomp_context* ctx, uintptr_t func) {
+    if (redirect_bypass == func) {
+        redirect_bypass = 0;
+        return 0;
+    }
+    auto find_it = redirects.find(func);
+    if (find_it == redirects.end()) {
