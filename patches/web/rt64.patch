+        const int count = MAIN_THREAD_EM_ASM_INT({
+            const learned = Module['rt64LearnedShaders'] ? Module['rt64LearnedShaders']($0 >>> 0) : [];
+            const count = Math.min(learned.length, $2);
+            for (let i = 0; i < count; i++) {
+                for (let j = 0; j < 6; j++) {
+                    HEAPU32[($1 >> 2) + i * 6 + j] = learned[i][j];
+                }
+            }
